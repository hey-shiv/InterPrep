    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.0.3",
    "eslint-plugin-react-hooks": "7.0.1",
